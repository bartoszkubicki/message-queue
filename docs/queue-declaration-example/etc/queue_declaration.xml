-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:BKubicki_MessageQueue:etc/queue_declaration.xsd">
    <queue name="example.declared" connection="amqp">
        <arguments>
            <argument name="x-dead-letter-exchange" xsi:type="string">example.dead_letter</argument>
            <argument name="x-message-ttl" xsi:type="number">5000</argument>
        </arguments>
    </queue>
    <!-- a declared queue does not need a binding -->
    <queue name="example.declared_unbound" connection="amqp" durable="false" autoDelete="true"/>
</config>
