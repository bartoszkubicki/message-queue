<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- API section -->
    <preference for="BKubicki\MessageQueue\Api\Queue\Consumer\EnvelopeCallbackFactoryInterface"
                type="BKubicki\MessageQueue\Queue\Consumer\EnvelopeCallbackFactory"/>
    <preference for="BKubicki\MessageQueue\Api\Envelope\RetryLimitOverflowResolverInterface"
                type="BKubicki\MessageQueue\Envelope\RetryLimitOverflowResolver"/>
    <!-- API section -->

    <!-- Plugins section -->
    <type name="Magento\Framework\MessageQueue\Topology\Config\QueueConfigItem\DataMapper">
        <plugin name="BKubicki_MessageQueue::AddDeclaredQueuesToTopology"
                type="BKubicki\MessageQueue\Plugin\Amqp\AddDeclaredQueuesToTopology"/>
    </type>
    <!-- End of plugins section -->
</config>
